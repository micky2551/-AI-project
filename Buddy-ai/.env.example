# Backend-only environment variables. Never place provider API keys in VITE_* variables.
PORT=8787
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set AI_PROVIDER=gemini to enable Gemini key rotation.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Optional: legacy single-key fallback is supported as GEMINI_API_KEY.
# GEMINI_API_KEY=

# Alternative provider settings when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
